# backend/.env.example — copy to backend/.env and fill in

# Stellar/Soroban RPC endpoint (public testnet by default)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase for signing transactions (testnet default)
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract that emits `meter` topic billing events
CONTRACT_ID=CBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Relayer account secret that submits device readings on-chain (G… keypair).
# Leave empty to accept readings locally without on-chain submission.
RELAYER_SECRET=

# How often to poll getEvents (ms)
POLL_INTERVAL_MS=5000

# Local cache DB (sqlite default; swap to postgres in production)
DB_PATH=./data/billing.db
DATABASE_URL=

# Built frontend bundle served statically by the API when present
FRONTEND_DIST=../frontend/dist

HTTP_PORT=8080
WS_PORT=8080