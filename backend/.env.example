# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iot_billing
TIMESCALEDB_URL=postgresql://postgres:postgres@localhost:5432/iot_billing_timescale

# Redis
REDIS_URL=redis://localhost:6379

# Soroban / Stellar
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
CONTRACT_ID=
ADMIN_SECRET_KEY=

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
CHALLENGE_TTL_SECONDS=300

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=iot-billing-backend

# Ingestion
MAX_PAYLOAD_SIZE_BYTES=65536
NONCE_WINDOW_MS=5000

# Runtime configuration integrity. Map key ids to PEM-encoded Ed25519 public
# keys; production must provide at least one key and config:active must contain
# a signed envelope (documented in docs/runtime-configuration-auditing.md).
RUNTIME_CONFIG_AUTHORIZED_KEYS={}
RUNTIME_CONFIG_AUDIT_SCAN_INTERVAL_MS=1000

# Service Mesh / Mutual TLS (issue #277)
# Enforcement level: STRICT (default) or PERMISSIVE (canary rollout only)
MTLS_MODE=STRICT
# Comma-separated SPIFFE URIs allowed to connect (empty = any valid cert)
MTLS_ALLOWED_SPIFFE_URIS=
# Days before cert expiry to emit a Prometheus warning
MTLS_CERT_EXPIRY_WARN_DAYS=30
# Trust X-Forwarded-Client-Cert header from Envoy/Istio sidecar
MTLS_TRUST_XFCC_HEADER=true

# PKI Hardware Identity Binding (issue #294)
# PEM-encoded CA certificate(s) as the hardware device PKI trust anchor.
# Multiple PEM blocks can be concatenated. Leave empty to skip PKI verification
# (development only — production must set this).
PKI_CA_CERT_PEMS=
# Comma-separated SPIFFE URIs allowed to present device certificates.
# Empty = skip SPIFFE validation (CN-only mode).
PKI_ALLOWED_SPIFFE_URIS=
# Days before device certificate expiry to emit a Prometheus warning
PKI_CERT_EXPIRY_WARN_DAYS=30
# Set to true to bypass PKI chain verification (development/test only)
PKI_SKIP_VERIFICATION=false
