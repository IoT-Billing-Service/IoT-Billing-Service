generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id          String   @id @default(cuid())
  serial      String   @unique
  publicKey   String   @map("public_key")
  ownerId     String   @map("owner_id")
  enabled     Boolean  @default(true)
  /// ISO 3166-1 alpha-2 country code of the node's physical location.
  /// Used by the geographic pricing engine (issue #54) to select the correct
  /// billing tier multiplier. NULL devices fall back to the ROW (rest-of-world)
  /// tier with a 1.0× multiplier.
  countryCode String?  @map("country_code") @db.Char(2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  billingRecords BillingRecord[]
  telemetryData  TelemetryData[]

  @@map("devices")
}

model Account {
  id              String   @id @default(cuid())
  stellarAddress  String   @unique @map("stellar_address")
  balance         BigInt   @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  billingRecords  BillingRecord[]
  webhookSecrets  WebhookSecret[]
  webhookSubscriptions WebhookSubscription[]
  billingCycles   BillingCycle[]
  refunds         RefundRecord[]

  @@map("accounts")
}

model BillingRecord {
  id          String   @id @default(cuid())
  deviceId    String   @map("device_id")
  accountId   String   @map("account_id")
  usageAmount BigInt   @map("usage_amount")
  txHash      String?  @map("tx_hash")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  cycleId     String?  @map("cycle_id")

  device Device @relation(fields: [deviceId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
  cycle   BillingCycle? @relation(fields: [cycleId], references: [id])
  refunds RefundRecord[]

  @@map("billing_records")
}

model RefundRecord {
  id              String   @id @default(cuid())
  billingRecordId String   @map("billing_record_id")
  accountId       String   @map("account_id")
  amount          BigInt
  state           String   @default("INITIATED")
  lockVersion     Int      @default(1) @map("lock_version")
  txHash          String?  @map("tx_hash")
  retryCount      Int      @default(0) @map("retry_count")
  reason          String?
  idempotencyKey  String   @unique @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  billingRecord   BillingRecord @relation(fields: [billingRecordId], references: [id])
  account         Account       @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([billingRecordId])
  @@index([state])
  @@map("refund_records")
}

/// A billing cycle transitions OPEN -> FINALIZING -> FINALIZED -> SETTLED.
/// `lockVersion` is an optimistic-concurrency token: every state write does
/// `WHERE id = ? AND lock_version = ?` and bumps the version, so two callers
/// racing the same transition cannot both win (issue #42).
model BillingCycle {
  id          String   @id @default(cuid())
  accountId   String   @map("account_id")
  state       String   @default("OPEN")
  lockVersion Int      @default(1) @map("lock_version")
  cycleUnit   String   @default("monthly") @map("cycle_unit")
  customDurationMs BigInt? @map("custom_duration_ms")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account         Account                  @relation(fields: [accountId], references: [id])
  billingRecords  BillingRecord[]
  finalizationLog BillingFinalizationLog[]
  geoPricingSnapshot GeoPricingSnapshot?

  @@index([state])
  @@map("billing_cycles")
}

/// Append-only log making finalization idempotent: a unique idempotency_key
/// means a replayed finalization for the same logical attempt is a no-op.
model BillingFinalizationLog {
  id             String   @id @default(cuid())
  cycleId        String   @map("cycle_id")
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  cycle BillingCycle @relation(fields: [cycleId], references: [id])

  @@map("billing_finalization_log")
}

model TelemetryData {
  id          String   @id @default(cuid())
  deviceId    String   @map("device_id")
  metricId    Int      @map("metric_id")
  metricValue Float    @map("metric_value")
  ingestedAt  DateTime @default(now()) @map("ingested_at")

  device Device @relation(fields: [deviceId], references: [id])

  @@map("telemetry_data")
}

model IngestionJob {
  id         String   @id @default(cuid())
  deviceId   String   @map("device_id")
  status     String   @default("pending")
  stateData  Json?    @map("state_data")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("ingestion_jobs")
}

model WebhookSecret {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  secret    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@map("webhook_secrets")
}

model WebhookSubscription {
  id         String   @id @default(cuid())
  accountId  String   @map("account_id")
  url        String
  eventTypes String[] @map("event_types")
  secretHash String   @map("secret_hash")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  account   Account          @relation(fields: [accountId], references: [id])
  deliveries WebhookDelivery[]

  @@index([accountId, enabled])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  subscriptionId String    @map("subscription_id")
  eventType      String    @map("event_type")
  eventId        String    @map("event_id")
  payload        Json
  status         String    @default("pending")
  attemptCount   Int       @default(0) @map("attempt_count")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model HardwareCertificate {
  serial    String   @id
  model     String
  batch     String
  revoked   Boolean  @default(false)
  /// True when this certificate batch has been enrolled in the PKI
  /// infrastructure (issue #294). Used to gate PKI-required flows.
  pkiVerified Boolean @default(false) @map("pki_verified")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attestationRecords AttestationRecord[]

  @@map("hardware_certificates")
}

/// Append-only attestation audit trail (issue #3).
/// Records every successful hardware attestation.  Rows are never mutated
/// after insertion — this provides an immutable, time-ordered ledger of all
/// verified device identities, satisfying PCI-DSS Req 10.3 and SOC2 CC7.2.
model AttestationRecord {
  id            String   @id @default(cuid())
  /// Device serial / identifier that was attested.
  deviceId      String   @map("device_id")
  /// Ed25519 public key (64 hex chars = 32 bytes) presented at attestation.
  publicKey     String   @map("public_key")
  /// Hardware certificate serial that backed this attestation.
  certSerial    String   @map("cert_serial")
  /// Nonce consumed during this attestation (prevents replay linkage).
  nonce         String
  /// SHA-512/256 digest (64 hex chars) of the canonical attestation message.
  /// Allows auditors to reproduce the verification without the original payload.
  messageDigest String   @map("message_digest")
  /// Server-side timestamp when attestation was accepted.
  attestedAt    DateTime @default(now()) @map("attested_at")
  createdAt     DateTime @default(now()) @map("created_at")
  /// SHA-256 fingerprint (hex) of the device leaf certificate (issue #294).
  /// Present when PKI hardware identity binding was verified.
  certFingerprint String? @map("cert_fingerprint")
  /// SPIFFE URI from the device certificate SAN (issue #294).
  spiffeUri     String?  @map("spiffe_uri")
  /// Expiry timestamp of the device leaf certificate (issue #294).
  certExpiresAt DateTime? @map("cert_expires_at")

  certificate HardwareCertificate @relation(fields: [certSerial], references: [serial])

  @@index([deviceId])
  @@index([certSerial])
  @@index([attestedAt])
  @@index([certFingerprint])
  @@index([spiffeUri])
  @@map("attestation_records")
}

model LedgerSyncState {
  syncId           String   @id @map("sync_id")
  lastSyncedLedger Int      @map("last_synced_ledger")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("ledger_sync_state")
}

/// Audit snapshot of the pricing tier table captured at finalization time
/// (issue #54). One row per billing cycle; the digest field lets auditors
/// verify that the rate table was not mutated between charge calculation and
/// settlement (PCI-DSS / SOC2 requirement).
model GeoPricingSnapshot {
  id          String   @id @default(cuid())
  cycleId     String   @unique @map("cycle_id")
  tableDigest String   @map("table_digest")
  tableJson   Json     @map("table_json")
  createdAt   DateTime @default(now()) @map("created_at")

  cycle BillingCycle @relation(fields: [cycleId], references: [id])

  @@map("geo_pricing_snapshots")
}

/// Append-only immutable audit log for billing transactions.
/// Provides cryptographic tamper-evidence satisfying PCI-DSS and SOC2.
model AuditLog {
  id           String   @id @default(cuid())
  entityType   String   @map("entity_type") // e.g., 'BillingRecord', 'BillingCycle'
  entityId     String   @map("entity_id")
  action       String   // e.g., 'CREATE', 'FINALIZE', 'SETTLE', 'AUTOCORRECT'
  payload      Json     // The state change or operation metadata
  previousHash String   @map("previous_hash") // Hash of the immediately preceding AuditLog for this entity
  hash         String   // Cryptographic SHA-256 hash of this entry
  signature    String   // Ed25519 signature of the hash by the service private key
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Dead Letter Queue for messages that failed all processing attempts.
/// Provides a durable mechanism for manual inspection and replay, preventing data loss.
model DeadLetterMessage {
  id          String   @id @default(cuid())
  queueName   String   @map("queue_name")     // e.g., 'webhook_delivery', 'billing_job'
  payload     Json                              // The original message payload
  errorReason String   @map("error_reason")
  status      String   @default("pending")    // 'pending', 'resolved', 'ignored'
  retryCount  Int      @default(0) @map("retry_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([queueName, status])
  @@map("dead_letter_messages")
}

/// P2P Payment Channel for high-frequency IoT microtransactions (#295)
/// Allows off-chain signed microtransaction vouchers with on-chain settlement guarantees.
model PaymentChannel {
  id                   String   @id @default(cuid())
  channelId            String   @unique @map("channel_id")
  senderAddress        String   @map("sender_address")
  recipientAddress      String   @map("recipient_address")
  totalDeposit         BigInt   @map("total_deposit")
  settledAmount        BigInt   @default(0) @map("settled_amount")
  sequence             Int      @default(0)
  status               String   @default("OPEN")
  disputePeriodSeconds Int      @default(86400) @map("dispute_period_seconds")
  disputeExpiresAt     DateTime? @map("dispute_expires_at")
  expiresAt            DateTime @map("expires_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  vouchers             PaymentChannelVoucher[]
  disputes             PaymentChannelDispute[]

  @@index([senderAddress])
  @@index([recipientAddress])
  @@index([status])
  @@map("payment_channels")
}

/// Cryptographically signed payment voucher exchanged off-chain.
model PaymentChannelVoucher {
  id               String   @id @default(cuid())
  channelId        String   @map("channel_id")
  sequence         Int
  cumulativeAmount BigInt   @map("cumulative_amount")
  nonce            String
  expiresAt        DateTime @map("expires_at")
  signature        String
  signerPublicKey  String   @map("signer_public_key")
  digest           String
  createdAt        DateTime @default(now()) @map("created_at")

  channel          PaymentChannel @relation(fields: [channelId], references: [channelId])

  @@unique([channelId, sequence])
  @@index([channelId])
  @@map("payment_channel_vouchers")
}

/// Unilateral dispute record for peer-to-peer payment channels.
model PaymentChannelDispute {
  id                String   @id @default(cuid())
  channelId         String   @map("channel_id")
  initiatedBy       String   @map("initiated_by")
  claimedSequence   Int      @map("claimed_sequence")
  claimedAmount     BigInt   @map("claimed_amount")
  challengeDeadline DateTime @map("challenge_deadline")
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  channel           PaymentChannel @relation(fields: [channelId], references: [channelId])

  @@index([channelId, status])
  @@map("payment_channel_disputes")
}

